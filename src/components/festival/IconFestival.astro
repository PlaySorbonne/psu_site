---
import { Image } from "astro:assets";

interface Props {
  icon: ImageMetadata;
  title: string;
  desc: string;
  // truc truc
}

const { icon, title, desc} = Astro.props;
---

<div class="item">
  <Image src={icon} alt="icon" class="icon" width="50" />
  <p class="title">{title}</p>
  <span class="tooltiptext">{desc}</span>
</div>


<style>
  .item {
    position: relative;
    display: flex;
    cursor: pointer;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(var(--main-color), 0.5);
    margin: 1rem;
    padding: 0 10px;
    border-radius: 10px;
    transition: all 0.5s ease-in-out;
  }
  .item:hover {
    background-color: rgba(var(--main-color), 0.8);
    transform: scale(1.1);
    transition: all 0.5s ease-in-out;
  }
  .title {
    font-weight: bold;
  }
  
  /* la bulle se place au-dessus de l'icône (.item est le parent positionné) */
  .item .tooltiptext {
    visibility: hidden;
    width: max-content;
    max-width: min(340px, 80vw);
    background-color: black;
    color: #fff;
    font-weight: normal;
    text-align: center;
    /* les descriptions sur plusieurs lignes (expos…) gardent leurs retours */
    white-space: pre-line;
    border-radius: 5px;
    padding: 8px 10px;
    position: absolute;
    z-index: 10;
    bottom: 125%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .item:hover .tooltiptext{
    visibility: visible;
    opacity: 1;
  }

</style>