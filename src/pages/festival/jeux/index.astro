---
import Footer from "@/components/global/Footer.astro";
import HeaderL from "@/layouts/partials/HeaderL.astro";
import ColorLigne from "@/components/global/ColorLigne.astro";
import { Image } from "astro:assets";
import { clubLogos } from "@/assets/logos/psu";
import logos from "@/assets/logos";
import {
  getDevs,
  devSlug,
  imagesJeu,
  imageStudio,
  estJeuDePlateau,
  estJeuVideo,
} from "@/helpers/gamedevs";

const devs = await getDevs();

// même liste que la vue par studios, mais à plat : une carte par jeu
const jeux = devs
  .flatMap((dev) =>
    dev.jeux.map((jeu) => ({
      jeu,
      dev,
      // image de référence du jeu, sinon celle du studio
      image: imagesJeu(jeu)[0] ?? imageStudio(dev),
      link: `/festival/devs/${devSlug(dev)}#jeu-${jeu.id}`,
    })),
  )
  .sort((a, b) =>
    a.jeu.nom_jeu
      .trim()
      .localeCompare(b.jeu.nom_jeu.trim(), "fr", { sensitivity: "base" }),
  );
---

<HeaderL
  title="Les jeux du Festival Play Sorbonne"
  description="Tous les jeux vidéo et jeux de plateau indépendants présentés au Festival Play Sorbonne."
  metaImg="/assets/festival/logo_festival.png"
>
  <header class="header">
    <a href="/festival">
      <Image src={clubLogos.psu} alt="" class="logo__header" height="80" />
    </a>
  </header>
  <main>
    <section class="banner">
      <h1 class="title__banner redNeon">Les jeux</h1>
      <p class="subtitle__banner">
        Jeux vidéo et jeux de plateau indépendants du Festival Play Sorbonne
        2026
      </p>
    </section>
    <section class="section">
      <div class="content">
        <p class="breadcrumb">
          <a href="/festival">← Retour au festival</a>
        </p>
        <div class="title__list">
          <h2 class="title">Les jeux présentés au festival</h2>
          <ColorLigne />
        </div>
        {
          jeux.length > 0 && (
            <div class="barre">
              <div class="filtres" role="group" aria-label="Filtrer les jeux">
                <button class="filtre actif" data-filtre="tous">
                  Tous
                </button>
                <button class="filtre" data-filtre="plateau">
                  Jeux de plateau
                </button>
                <button class="filtre" data-filtre="video">
                  Jeux vidéo
                </button>
              </div>
              <div class="vues" role="group" aria-label="Changer de vue">
                <a class="vue" href="/festival/devs">
                  Par studios
                </a>
                <a class="vue actif" href="/festival/jeux" aria-current="page">
                  Par jeux
                </a>
              </div>
            </div>
          )
        }
        {
          jeux.length === 0 && (
            <p class="empty">
              Les jeux de cette édition seront bientôt annoncés, revenez un peu
              plus tard !
            </p>
          )
        }
        <div class="grid">
          {
            jeux.map(({ jeu, dev, image, link }) => (
              <a
                class="carte"
                href={link}
                data-plateau={estJeuDePlateau(jeu) ? "1" : undefined}
                data-video={estJeuVideo(jeu) ? "1" : undefined}
              >
                <div class="logo__wrapper">
                  {image ? (
                    <Image
                      class="logo"
                      src={image}
                      alt={jeu.nom_jeu}
                      width={400}
                      loading="lazy"
                      decoding="async"
                      inferSize
                    />
                  ) : (
                    <Image
                      class="logo"
                      src={logos.psu.champsu}
                      alt=""
                      width={400}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <div class="infos">
                  <h3 class="nom">{jeu.nom_jeu}</h3>
                  <p class="studio__nom">{dev.nom_studio}</p>
                  <p class="badges">
                    <span class="badge">{jeu.type_de_jeu.label}</span>
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</HeaderL>
<Footer />

<style>
  :root {
    --main-color: 232, 101, 173;
    --secondary-color: 41, 200, 255;
    --dark-color: 61, 61, 111;
    --main-bg: #f6f6f6;
  }

  /* footer collé en bas même quand la page est plus courte que l'écran */
  :global(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    width: 100%;
    overflow-x: hidden;
    flex: 1;
  }

  .header {
    z-index: 1000;
    position: fixed;
    top: 0;
    height: 100px;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    color: whitesmoke;
    border-bottom: rgba(255, 255, 255, 0.2) 1px solid;
    transition: top 0.3s;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-height: 320px;
    padding: 140px 2rem 2.5rem;
    background: linear-gradient(
      190deg,
      rgba(2, 0, 36, 1) 0%,
      rgb(41, 13, 97) 55%,
      #29105e 80%,
      rgb(75, 9, 44) 100%
    );
  }

  .title__banner {
    font-family: "No Continue", sans-serif;
    font-weight: lighter;
    text-transform: uppercase;
    color: white;
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: 2px;
    text-align: center;
  }

  .redNeon {
    text-shadow: 0 0 15px rgb(var(--main-color));
  }

  .subtitle__banner {
    color: rgb(177, 225, 241);
    font-weight: lighter;
    font-family: "No Continue", sans-serif;
    text-transform: uppercase;
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    text-shadow: 0 0 7px rgb(var(--secondary-color));
  }

  .section {
    padding: 2rem;
  }

  .content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .title {
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .title__list {
    margin-bottom: 2rem;
  }

  .breadcrumb {
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .empty {
    text-align: center;
  }

  .barre {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .filtres {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filtre {
    background-color: rgba(var(--main-color), 0.15);
    border: 1px solid rgb(var(--main-color));
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.95rem;
    font-weight: bold;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filtre:hover {
    background-color: rgba(var(--main-color), 0.35);
  }

  .filtre.actif {
    background-color: rgb(var(--main-color));
    color: white;
  }

  .vues {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .vue {
    background-color: rgba(var(--secondary-color), 0.15);
    border: 1px solid rgb(var(--secondary-color));
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.95rem;
    font-weight: bold;
    transition: all 0.3s ease;
  }

  .vue:hover {
    background-color: rgba(var(--secondary-color), 0.35);
  }

  .vue.actif {
    background-color: rgb(var(--secondary-color));
    color: white;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .carte.cache {
    display: none;
  }

  .carte {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 10px;
    background: white;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    transition: all 0.5s ease-in-out;
  }

  .carte:hover {
    transform: scale(1.03);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .logo__wrapper {
    height: 180px;
    background: rgb(var(--dark-color));
  }

  .logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }

  .infos {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nom {
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .studio__nom {
    color: rgba(var(--black-text), 0.8);
    text-align: left;
  }

  .badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    background-color: rgba(var(--main-color), 0.2);
    border: 1px solid rgb(var(--main-color));
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    font-size: 0.85rem;
    font-weight: bold;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // filtre jeux de plateau / jeux vidéo (data-plateau / data-video des cartes)
    const boutons = document.querySelectorAll<HTMLElement>(".filtre");
    const cartes = document.querySelectorAll<HTMLElement>(".carte");
    boutons.forEach((bouton) =>
      bouton.addEventListener("click", () => {
        boutons.forEach((b) => b.classList.toggle("actif", b === bouton));
        const filtre = bouton.dataset.filtre!;
        cartes.forEach((carte) =>
          carte.classList.toggle(
            "cache",
            filtre !== "tous" && !carte.dataset[filtre],
          ),
        );
      }),
    );

    let prevScrollPos = window.scrollY;

    window.addEventListener("scroll", function () {
      const currentScrollPos = window.scrollY;
      const header = document.querySelector<HTMLElement>(".header");
      if (!header) return;

      if (prevScrollPos > currentScrollPos || currentScrollPos < 80) {
        header.style.top = "0";
      } else {
        header.style.top = "-200px";
      }

      prevScrollPos = currentScrollPos;
    });
  });
</script>
