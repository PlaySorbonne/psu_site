---
/*
 * La liste des jeux du festival : même grille que la liste des studios,
 * mais à plat, une carte par jeu. Chaque carte mène à la fiche du jeu sur
 * la page de son studio.
 *
 * Les jeux viennent de l'API gamedevs, au moment du build.
 */
import { Image } from "astro:assets";
import Coquille from "@/components/festival/psuf2026/Coquille.astro";
import BarreFiltres from "@/components/festival/psuf2026/BarreFiltres.astro";
import { festival } from "@/data/psuf2026";
import {
  getDevs,
  devSlug,
  imagesJeu,
  imageStudio,
  estJeuDePlateau,
  estJeuVideo,
} from "@/helpers/gamedevs";

const devs = await getDevs();

// même liste que la vue par studios, mais à plat : une carte par jeu
const jeux = devs
  .flatMap((dev) =>
    dev.jeux.map((jeu) => ({
      jeu,
      dev,
      // image de référence du jeu, sinon celle du studio
      image: imagesJeu(jeu)[0] ?? imageStudio(dev),
      plateau: estJeuDePlateau(jeu),
      video: estJeuVideo(jeu),
      link: `/festival/devs/${devSlug(dev)}#jeu-${jeu.id}`,
    })),
  )
  .sort((a, b) =>
    a.jeu.nom_jeu
      .trim()
      .localeCompare(b.jeu.nom_jeu.trim(), "fr", { sensitivity: "base" }),
  );

const nbPlateau = jeux.filter((j) => j.plateau).length;
const nbVideo = jeux.filter((j) => j.video).length;

/* les quatre coupes de blocs tournent d'une carte à l'autre */
const COUPES = ["", "bloc--b", "bloc--c", "bloc--d"];
---

<Coquille
  title="Les jeux du Festival Play Sorbonne 2026"
  description={`Les ${jeux.length} jeux vidéo et jeux de plateau indépendants jouables au Festival Play Sorbonne 2026, le ${festival.dateTexte.toLowerCase()}.`}
  prefetchs={["/festival", "/festival/devs"]}
>
  <section class="bande s-tete" id="tete">
    <svg
      class="deco s-tete__deco s-tete__deco--de20"
      viewBox="0 0 178 199"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-de20"></use></svg
    >
    <svg
      class="deco s-tete__deco s-tete__deco--etoile"
      viewBox="0 0 598 567"
      aria-hidden="true"
      focusable="false"><use href="#psuf-etoile"></use></svg
    >
    <svg
      class="deco s-tete__deco s-tete__deco--pacman"
      viewBox="0 0 198 161"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-pacman"></use></svg
    >

    <div class="enveloppe">
      <a class="s-tete__fil" href="/festival"
        ><i aria-hidden="true">←</i> Le festival</a
      >

      <div class="s-tete__titrage">
        <div>
          <p class="oeil s-tete__oeil">
            10<sup>e</sup> édition · {festival.jourCourt}
          </p>
          <h1 class="s-tete__titre">Les jeux</h1>
        </div>
        <div class="bloc bloc--b bloc-blanc s-tete__chapeau">
          <p>
            <b>{jeux.length} jeux indépendants</b> sont jouables toute la journée,
            de 10h à 19h&nbsp;: {nbPlateau} jeux de plateau et {nbVideo} jeux vidéo,
            à essayer avec leurs équipes.
          </p>
          <p>
            Tout est jouable, tout est indé. Chaque jeu renvoie vers la page de
            son studio.
          </p>
        </div>
      </div>

      <ul class="cpts">
        <li class="bloc cpt cpt--un">
          <span class="cpt__n">{jeux.length}</span>
          <span class="cpt__l">jeux inscrits</span>
        </li>
        <li class="bloc bloc--b cpt cpt--deux">
          <span class="cpt__n">{devs.length}</span>
          <span class="cpt__l">studios présents</span>
        </li>
        <li class="bloc bloc--c cpt cpt--plateau">
          <svg
            class="cpt__marque"
            viewBox="0 0 200 195"
            aria-hidden="true"
            focusable="false"><use href="#psuf-doodle-meeple"></use></svg
          >
          <span class="cpt__n">{nbPlateau}</span>
          <span class="cpt__l">jeux de plateau</span>
        </li>
        <li class="bloc bloc--d cpt cpt--video">
          <svg
            class="cpt__marque"
            viewBox="0 0 200 172"
            aria-hidden="true"
            focusable="false"><use href="#psuf-doodle-manette"></use></svg
          >
          <span class="cpt__n">{nbVideo}</span>
          <span class="cpt__l">jeux vidéo</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="bande s-liste" id="liste">
    <svg
      class="deco s-liste__deco s-liste__deco--eclair"
      viewBox="0 0 523 599"
      aria-hidden="true"
      focusable="false"><use href="#psuf-eclair-large"></use></svg
    >
    <svg
      class="deco s-liste__deco s-liste__deco--triangle"
      viewBox="0 0 232 596"
      aria-hidden="true"
      focusable="false"><use href="#psuf-triangle-rose2"></use></svg
    >

    <div class="enveloppe">
      {
        jeux.length > 0 && (
          <BarreFiltres vue="jeux" nom="jeux" total={jeux.length} />
        )
      }
      {
        jeux.length === 0 && (
          <p class="bloc bloc--c bloc-blanc s-liste__vide">
            Les jeux de cette édition seront bientôt annoncés, revenez un peu
            plus tard !
          </p>
        )
      }

      <ul class="grille">
        {
          jeux.map(({ jeu, dev, image, plateau, video, link }, i) => (
            <li
              data-plateau={plateau ? "1" : undefined}
              data-video={video ? "1" : undefined}
            >
              <a class:list={["bloc", COUPES[i % 4], "tuile"]} href={link}>
                <p
                  class:list={[
                    "tuile__ruban",
                    plateau && video
                      ? "tuile__ruban--mixte"
                      : plateau
                        ? "tuile__ruban--plateau"
                        : "tuile__ruban--video",
                  ]}
                >
                  <svg
                    class="tuile__pico"
                    viewBox="0 0 200 195"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <use
                      href={
                        plateau ? "#psuf-doodle-meeple" : "#psuf-doodle-manette"
                      }
                    />
                  </svg>
                  {jeu.type_de_jeu.label}
                </p>
                <span class="tuile__vign">
                  {image ? (
                    <Image
                      class="tuile__img"
                      src={image}
                      alt={`Visuel du jeu ${jeu.nom_jeu}`}
                      width={420}
                      fit="inside"
                      loading="lazy"
                      decoding="async"
                      inferSize
                    />
                  ) : (
                    <svg
                      class="tuile__de"
                      viewBox="0 0 4230 4458"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <use href="#psuf-champsu" />
                    </svg>
                  )}
                </span>
                <span class="tuile__corps">
                  <span class="tuile__nom">{jeu.nom_jeu}</span>
                  <span class="tuile__meta tuile__meta--studio">
                    {dev.nom_studio}
                  </span>
                  {jeu.style_jeu && (
                    <span class="tuile__meta">{jeu.style_jeu}</span>
                  )}
                </span>
                <span class="tuile__plus">
                  Voir le jeu <i aria-hidden="true">→</i>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Coquille>
