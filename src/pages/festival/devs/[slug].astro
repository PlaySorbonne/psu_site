---
/*
 * La page d'un studio : son enseigne, puis une fiche par jeu, chacune
 * ancrée sur #jeu-<id> (c'est la cible des deux listes et du carrousel
 * de la page du festival).
 *
 * Même DA que le reste du festival : blocs polygonaux, aplats francs,
 * grain, aucun néon.
 */
import { Image } from "astro:assets";
import Coquille from "@/components/festival/psuf2026/Coquille.astro";
import Galerie from "@/components/festival/Galerie.astro";
import { festival } from "@/data/psuf2026";
import {
  getDevs,
  devSlug,
  lienInsta,
  lienJeu,
  imagesJeu,
  logoStudio,
  estJeuDePlateau,
  estJeuVideo,
  type DevT,
} from "@/helpers/gamedevs";

export async function getStaticPaths() {
  const devs = await getDevs();
  return devs.map((dev) => ({
    params: { slug: devSlug(dev) },
    props: { dev },
  }));
}

type Props = { dev: DevT };
const { dev } = Astro.props;
const insta = lienInsta(dev.insta);
const logo = logoStudio(dev);

const nbPlateau = dev.jeux.filter(estJeuDePlateau).length;
const nbVideo = dev.jeux.filter(estJeuVideo).length;

/*
 * Une fiche par jeu. Les jeux illustrés alternent gauche / droite ; ceux
 * qui n'ont aucun visuel prennent toute la largeur, et ne comptent donc
 * pas dans l'alternance — sinon deux galeries se suivraient du même côté.
 */
let illustres = 0;
const fiches = dev.jeux.map((jeu, i) => {
  const visuels = imagesJeu(jeu);
  return {
    jeu,
    visuels,
    lien: lienJeu(jeu, dev),
    miroir: visuels.length > 0 && illustres++ % 2 === 1,
    coupe: i % 2 === 1 ? "bloc--c" : "bloc--d",
  };
});
---

<Coquille
  title={`${dev.nom_studio} — Festival Play Sorbonne 2026`}
  description={`${dev.nom_studio} présente ${dev.jeux.map((jeu) => jeu.nom_jeu).join(", ")} au Festival Play Sorbonne 2026, le ${festival.dateTexte.toLowerCase()}.`}
  prefetchs={["/festival/devs", "/festival/jeux"]}
>
  <section class="bande s-tete s-tete--studio" id="tete">
    <svg
      class="deco s-tete__deco s-tete__deco--de20"
      viewBox="0 0 178 199"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-de20"></use></svg
    >
    <svg
      class="deco s-tete__deco s-tete__deco--etoile"
      viewBox="0 0 598 567"
      aria-hidden="true"
      focusable="false"><use href="#psuf-etoile"></use></svg
    >

    <div class="enveloppe">
      <a class="s-tete__fil" id="retour" href="/festival/devs"
        ><i aria-hidden="true">←</i> Tous les studios</a
      >

      <div class="s-tete__titrage">
        {
          logo && (
            <div class="bloc bloc--c bloc-blanc s-tete__logo">
              <Image
                src={logo}
                alt={`Logo du studio ${dev.nom_studio}`}
                width={420}
                fit="inside"
                inferSize
              />
            </div>
          )
        }
        <div>
          <p class="oeil s-tete__oeil">Studio présent au festival</p>
          <h1 class="s-tete__titre">{dev.nom_studio}</h1>
          {
            insta && (
              <a
                class="bloc bloc--d s-tete__insta"
                href={insta.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {insta.label}
              </a>
            )
          }
        </div>
      </div>

      {
        dev.jeux.length > 0 && (
          <ul class="cpts">
            <li class="bloc cpt cpt--un">
              <span class="cpt__n">{dev.jeux.length}</span>
              <span class="cpt__l">
                {dev.jeux.length > 1 ? "jeux présentés" : "jeu présenté"}
              </span>
            </li>
            {nbPlateau > 0 && (
              <li class="bloc bloc--c cpt cpt--plateau">
                <svg
                  class="cpt__marque"
                  viewBox="0 0 200 195"
                  aria-hidden="true"
                  focusable="false"
                >
                  <use href="#psuf-doodle-meeple" />
                </svg>
                <span class="cpt__n">{nbPlateau}</span>
                <span class="cpt__l">
                  {nbPlateau > 1 ? "jeux de plateau" : "jeu de plateau"}
                </span>
              </li>
            )}
            {nbVideo > 0 && (
              <li class="bloc bloc--d cpt cpt--video">
                <svg
                  class="cpt__marque"
                  viewBox="0 0 200 172"
                  aria-hidden="true"
                  focusable="false"
                >
                  <use href="#psuf-doodle-manette" />
                </svg>
                <span class="cpt__n">{nbVideo}</span>
                <span class="cpt__l">
                  {nbVideo > 1 ? "jeux vidéo" : "jeu vidéo"}
                </span>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </section>

  <section class="bande s-fiches" id="fiches">
    <svg
      class="deco s-fiches__deco s-fiches__deco--de20"
      viewBox="0 0 178 199"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-de20"></use></svg
    >
    <svg
      class="deco s-fiches__deco s-fiches__deco--etoile"
      viewBox="0 0 598 567"
      aria-hidden="true"
      focusable="false"><use href="#psuf-etoile"></use></svg
    >

    <div class="enveloppe">
      {
        dev.jeux.length === 0 && (
          <p class="bloc bloc--c bloc-blanc s-liste__vide">
            Les jeux de ce studio seront bientôt annoncés !
          </p>
        )
      }

      <ul class="fiches">
        {
          fiches.map(({ jeu, visuels, lien, miroir, coupe }) => {
            return (
              <li
                class:list={[
                  "fiche",
                  visuels.length === 0 && "fiche--seule",
                  miroir && "fiche--miroir",
                ]}
                id={`jeu-${jeu.id}`}
              >
                {visuels.length > 0 && (
                  <div class="bloc bloc--b fiche__vis">
                    <Galerie images={visuels} alt={jeu.nom_jeu} />
                  </div>
                )}
                <article
                  class:list={["bloc", coupe, "bloc-blanc", "fiche__infos"]}
                >
                  <h2 class="fiche__titre">{jeu.nom_jeu}</h2>
                  <p class="fiche__types">
                    {estJeuDePlateau(jeu) && (
                      <span class="type type--plateau">
                        <svg
                          class="type__pico"
                          viewBox="0 0 200 195"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <use href="#psuf-doodle-meeple" />
                        </svg>
                        Jeu de plateau
                      </span>
                    )}
                    {estJeuVideo(jeu) && (
                      <span class="type type--video">
                        <svg
                          class="type__pico"
                          viewBox="0 0 200 172"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <use href="#psuf-doodle-manette" />
                        </svg>
                        Jeu vidéo
                      </span>
                    )}
                  </p>
                  {jeu.style_jeu && <p class="fiche__style">{jeu.style_jeu}</p>}
                  {jeu.description_jeu && (
                    <p class="fiche__desc">{jeu.description_jeu}</p>
                  )}
                  {lien && (
                    <p class="fiche__btn">
                      <a
                        class="btn btn--jaune"
                        href={lien}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        En savoir plus
                        <svg
                          class="fiche__fleche"
                          viewBox="0 0 24 12"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path
                            d="M0 4.7h16.4V0L24 6l-7.6 6V7.3H0z"
                            fill="currentColor"
                          />
                        </svg>
                      </a>
                    </p>
                  )}
                </article>
              </li>
            );
          })
        }
      </ul>

      <div class="bloc bloc--c bloc-blanc s-fiches__sortie">
        <p class="oeil s-fiches__sortie-oeil">Les listes complètes</p>
        <p>
          Tous les studios et tous les jeux de la 10<sup>e</sup> édition, avec leurs
          visuels et leurs liens, sont sur les deux pages dédiées.
        </p>
        <p class="s-fiches__boutons">
          <a class="btn btn--jaune" href="/festival/devs">Les studios</a>
          <a class="btn btn--nuit" href="/festival/jeux">Les jeux</a>
        </p>
      </div>
    </div>
  </section>
</Coquille>

<script>
  document.addEventListener("astro:page-load", () => {
    /* Le lien de retour suit d'où l'on vient : la liste des jeux si c'est
       par elle qu'on est arrivé, la liste des studios sinon. */
    const retour = document.querySelector<HTMLAnchorElement>("a#retour");
    if (!retour) return;

    const index = history.state?.index;
    const precedent =
      typeof index === "number" && index > 0
        ? sessionStorage.getItem(`nav:${index - 1}`)?.replace(/\/+$/, "")
        : null;

    if (precedent === "/festival/jeux") {
      retour.href = "/festival/jeux";
      retour.innerHTML = '<i aria-hidden="true">←</i> Tous les jeux';
    }
    if (precedent === "/festival/jeux" || precedent === "/festival/devs")
      retour.addEventListener("click", (e) => {
        e.preventDefault();
        history.back();
      });
  });
</script>
