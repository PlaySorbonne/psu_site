---
import Footer from "@/components/global/Footer.astro";
import HeaderL from "@/layouts/partials/HeaderL.astro";
import ColorLigne from "@/components/global/ColorLigne.astro";
import Galerie from "@/components/festival/Galerie.astro";
import { Image } from "astro:assets";
import { clubLogos } from "@/assets/logos/psu";
import {
  getDevs,
  devSlug,
  lienInsta,
  lienJeu,
  liensAffichables,
  mediasJeu,
  mediasStudio,
  documentsStudio,
  logoStudio,
  type DevT,
} from "@/helpers/gamedevs";

export async function getStaticPaths() {
  const devs = await getDevs();
  return devs.map((dev) => ({
    params: { slug: devSlug(dev) },
    props: { dev },
  }));
}

type Props = { dev: DevT };
const { dev } = Astro.props;
const insta = lienInsta(dev.insta);
const logo = logoStudio(dev);
const liensStudio = liensAffichables(dev.liens).filter(
  (lien) => lien.url !== insta?.url,
);
const galerieStudio = mediasStudio(dev);
const documents = documentsStudio(dev);
---

<HeaderL
  title={`${dev.nom_studio} — Festival Play Sorbonne`}
  description={dev.description_studio ||
    `${dev.nom_studio} présente ${dev.jeux.map((jeu) => jeu.nom_jeu).join(", ")} au Festival Play Sorbonne.`}
  metaImg="/assets/festival/logo_festival.png"
>
  <header class="header">
    <a href="/festival">
      <Image src={clubLogos.psu} alt="" class="logo__header" height="80" />
    </a>
  </header>
  <main>
    <section class="banner">
      {
        logo && (
          <Image
            class="logo__studio"
            src={logo}
            alt=""
            width={300}
            inferSize
          />
        )
      }
      <h1 class="title__banner redNeon">{dev.nom_studio}</h1>
      {
        (insta || liensStudio.length > 0) && (
          <p class="liens__studio">
            {insta && (
              <a
                class="insta"
                href={insta.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {insta.label}
              </a>
            )}
            {liensStudio.map((lien) => (
              <a
                class="insta"
                href={lien.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {lien.label}
              </a>
            ))}
          </p>
        )
      }
    </section>
    <section class="section">
      <div class="content">
        <p class="breadcrumb">
          <a id="retour" href="/festival/devs">← Tous les studios</a>
        </p>
        {
          (dev.description_studio ||
            galerieStudio.length > 0 ||
            documents.length > 0) && (
            <article class="studio__presentation">
              {dev.description_studio && (
                <p class="description">{dev.description_studio}</p>
              )}
              {galerieStudio.length > 0 && (
                <div class="galerie__studio">
                  <Galerie medias={galerieStudio} alt={dev.nom_studio} />
                </div>
              )}
              {documents.length > 0 && (
                <p class="documents">
                  {documents.map((doc) => (
                    <a href={doc.url} target="_blank" rel="noopener noreferrer">
                      📄 {doc.nom}
                    </a>
                  ))}
                </p>
              )}
            </article>
          )
        }
        {
          dev.jeux.map((jeu) => {
            const medias = mediasJeu(jeu);
            const lien = lienJeu(jeu, dev);
            const autresLiens = liensAffichables(jeu.liens).filter(
              (l) => l.url !== lien,
            );
            return (
              <article class="jeu" id={`jeu-${jeu.id}`}>
                {medias.length > 0 && (
                  <div class="image__jeu">
                    <Galerie medias={medias} alt={jeu.nom_jeu} />
                  </div>
                )}
                <div class="infos__jeu">
                  <h2 class="nom__jeu">{jeu.nom_jeu}</h2>
                  <ColorLigne />
                  <p class="badges">
                    <span class="badge">{jeu.type_de_jeu.label}</span>
                  </p>
                  {jeu.style_jeu && <p class="style__jeu">{jeu.style_jeu}</p>}
                  {jeu.description_jeu && (
                    <p class="description">{jeu.description_jeu}</p>
                  )}
                  {lien && (
                    <a
                      class="site"
                      href={lien}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      En savoir plus
                    </a>
                  )}
                  {autresLiens.length > 0 && (
                    <p class="autres__liens">
                      {autresLiens.map((l) => (
                        <a
                          href={l.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {l.label}
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </article>
            );
          })
        }
        {
          dev.jeux.length === 0 && (
            <p class="empty">
              Les jeux de ce studio seront bientôt annoncés !
            </p>
          )
        }
      </div>
    </section>
  </main>
</HeaderL>
<Footer />

<style>
  :root {
    --main-color: 232, 101, 173;
    --secondary-color: 41, 200, 255;
    --dark-color: 61, 61, 111;
    --main-bg: #f6f6f6;
  }

  /* footer collé en bas même quand la page est plus courte que l'écran */
  :global(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    width: 100%;
    overflow-x: hidden;
    flex: 1;
  }

  .header {
    z-index: 1000;
    position: fixed;
    top: 0;
    height: 100px;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    color: whitesmoke;
    border-bottom: rgba(255, 255, 255, 0.2) 1px solid;
    transition: top 0.3s;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 320px;
    padding: 140px 2rem 2.5rem;
    background: linear-gradient(
      190deg,
      rgba(2, 0, 36, 1) 0%,
      rgb(41, 13, 97) 55%,
      #29105e 80%,
      rgb(75, 9, 44) 100%
    );
  }

  .logo__studio {
    max-height: 150px;
    width: auto;
    object-fit: contain;
  }

  .title__banner {
    font-family: "No Continue", sans-serif;
    font-weight: lighter;
    text-transform: uppercase;
    color: white;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: 2px;
    text-align: center;
  }

  .redNeon {
    text-shadow: 0 0 15px rgb(var(--main-color));
  }

  .liens__studio {
    display: flex;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .insta {
    color: rgb(177, 225, 241);
    text-shadow: 0 0 7px rgb(var(--secondary-color));
    font-weight: bold;
  }

  .insta:hover {
    text-decoration: underline;
  }

  .studio__presentation {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 2rem 0 2.5rem;
  }

  .galerie__studio {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
  }

  .documents {
    display: flex;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
  }

  .documents a {
    font-weight: bold;
  }

  .documents a:hover {
    text-decoration: underline;
  }

  .section {
    padding: 2rem;
  }

  .content {
    max-width: 1000px;
    margin: 0 auto;
  }

  .breadcrumb {
    font-weight: bold;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .jeu {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin: 2.5rem 0;
    /* pour que l'ancre #jeu-<id> ne soit pas masquée par le header fixe */
    scroll-margin-top: 120px;
  }

  /* "of .jeu" : le bloc de présentation du studio ne décale pas l'alternance */
  .jeu:nth-child(even of .jeu) {
    flex-direction: row-reverse;
  }

  .image__jeu {
    flex: 0 0 55%;
    min-width: 0;
  }

  .infos__jeu {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nom__jeu {
    font-size: 1.8rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    background-color: rgba(var(--main-color), 0.2);
    border: 1px solid rgb(var(--main-color));
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .style__jeu {
    font-style: italic;
    color: rgba(var(--black-text), 0.85);
  }

  .site {
    align-self: flex-start;
    padding: 0.6rem 1.5rem;
    border-radius: 5px;
    background-color: rgb(var(--main-color));
    color: white;
    font-weight: 700;
    transition: all 0.3s ease-in-out;
  }

  .site:hover {
    transform: scale(1.05);
  }

  .autres__liens {
    display: flex;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }

  .autres__liens a {
    font-weight: bold;
    text-decoration: underline;
  }

  .empty {
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .jeu,
    .jeu:nth-child(even of .jeu) {
      flex-direction: column;
    }

    .image__jeu {
      flex: none;
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // bouton retour : si on vient d'un des deux listings du site, un vrai
    // retour arrière (position de scroll conservée, libellé adapté) ; sinon
    // le lien se comporte normalement (vers la liste des studios)
    const retour = document.querySelector<HTMLAnchorElement>("a#retour");
    if (retour) {
      const index = history.state?.index;
      const precedent =
        typeof index === "number" && index > 0
          ? sessionStorage.getItem(`nav:${index - 1}`)?.replace(/\/+$/, "")
          : null;
      if (precedent === "/festival/jeux") {
        retour.href = "/festival/jeux";
        retour.textContent = "← Tous les jeux";
      }
      if (precedent === "/festival/jeux" || precedent === "/festival/devs")
        retour.addEventListener("click", (e) => {
          e.preventDefault();
          history.back();
        });
    }

    let prevScrollPos = window.scrollY;

    window.addEventListener("scroll", function () {
      const currentScrollPos = window.scrollY;
      const header = document.querySelector<HTMLElement>(".header");
      if (!header) return;

      if (prevScrollPos > currentScrollPos || currentScrollPos < 80) {
        header.style.top = "0";
      } else {
        header.style.top = "-200px";
      }

      prevScrollPos = currentScrollPos;
    });
  });
</script>
