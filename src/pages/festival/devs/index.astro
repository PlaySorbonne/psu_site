---
/*
 * La liste des studios du festival, à la DA 2026 : blocs polygonaux,
 * aplats francs, grain. La coquille (en-tête collant, pied d'affiche,
 * décors) est partagée avec la page du festival et la liste des jeux.
 *
 * Les studios viennent de l'API gamedevs, au moment du build.
 */
import { Image } from "astro:assets";
import Coquille from "@/components/festival/psuf2026/Coquille.astro";
import BarreFiltres from "@/components/festival/psuf2026/BarreFiltres.astro";
import { festival } from "@/data/psuf2026";
import {
  getDevs,
  devSlug,
  imageStudio,
  estJeuDePlateau,
  estJeuVideo,
} from "@/helpers/gamedevs";

const devs = (await getDevs()).sort((a, b) =>
  a.nom_studio
    .trim()
    .localeCompare(b.nom_studio.trim(), "fr", { sensitivity: "base" }),
);

const tousLesJeux = devs.flatMap((dev) => dev.jeux);
const nbJeux = tousLesJeux.length;
const nbPlateau = tousLesJeux.filter(estJeuDePlateau).length;
const nbVideo = tousLesJeux.filter(estJeuVideo).length;

/* les quatre coupes de blocs tournent d'une carte à l'autre : c'est ce qui
   empêche la grille de retomber sur une rangée de rectangles identiques */
const COUPES = ["", "bloc--b", "bloc--c", "bloc--d"];
---

<Coquille
  title="Les studios du Festival Play Sorbonne 2026"
  description={`Les ${devs.length} studios indépendants présents au Festival Play Sorbonne 2026, et les ${nbJeux} jeux qu'ils font essayer le ${festival.dateTexte.toLowerCase()}.`}
  prefetchs={["/festival", "/festival/jeux"]}
>
  <section class="bande s-tete" id="tete">
    <svg
      class="deco s-tete__deco s-tete__deco--de20"
      viewBox="0 0 178 199"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-de20"></use></svg
    >
    <svg
      class="deco s-tete__deco s-tete__deco--etoile"
      viewBox="0 0 598 567"
      aria-hidden="true"
      focusable="false"><use href="#psuf-etoile"></use></svg
    >
    <svg
      class="deco s-tete__deco s-tete__deco--pacman"
      viewBox="0 0 198 161"
      aria-hidden="true"
      focusable="false"><use href="#psuf-doodle-pacman"></use></svg
    >

    <div class="enveloppe">
      <a class="s-tete__fil" href="/festival"
        ><i aria-hidden="true">←</i> Le festival</a
      >

      <div class="s-tete__titrage">
        <div>
          <p class="oeil s-tete__oeil">
            10<sup>e</sup> édition · {festival.jourCourt}
          </p>
          <h1 class="s-tete__titre">Les studios</h1>
        </div>
        <div class="bloc bloc--b bloc-blanc s-tete__chapeau">
          <p>
            <b>{devs.length} studios indépendants</b> tiennent eux-mêmes leur table
            au festival, de 10h à 19h, et font essayer <b>{nbJeux} jeux</b>.
          </p>
          <p>
            Vous jouez, vous posez vos questions, l&rsquo;équipe repart avec un
            avis de plus.
          </p>
        </div>
      </div>

      <ul class="cpts">
        <li class="bloc cpt cpt--un">
          <span class="cpt__n">{devs.length}</span>
          <span class="cpt__l">studios présents</span>
        </li>
        <li class="bloc bloc--b cpt cpt--deux">
          <span class="cpt__n">{nbJeux}</span>
          <span class="cpt__l">jeux inscrits</span>
        </li>
        <li class="bloc bloc--c cpt cpt--plateau">
          <svg
            class="cpt__marque"
            viewBox="0 0 200 195"
            aria-hidden="true"
            focusable="false"><use href="#psuf-doodle-meeple"></use></svg
          >
          <span class="cpt__n">{nbPlateau}</span>
          <span class="cpt__l">jeux de plateau</span>
        </li>
        <li class="bloc bloc--d cpt cpt--video">
          <svg
            class="cpt__marque"
            viewBox="0 0 200 172"
            aria-hidden="true"
            focusable="false"><use href="#psuf-doodle-manette"></use></svg
          >
          <span class="cpt__n">{nbVideo}</span>
          <span class="cpt__l">jeux vidéo</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="bande s-liste" id="liste">
    <svg
      class="deco s-liste__deco s-liste__deco--eclair"
      viewBox="0 0 523 599"
      aria-hidden="true"
      focusable="false"><use href="#psuf-eclair-large"></use></svg
    >
    <svg
      class="deco s-liste__deco s-liste__deco--triangle"
      viewBox="0 0 232 596"
      aria-hidden="true"
      focusable="false"><use href="#psuf-triangle-rose2"></use></svg
    >

    <div class="enveloppe">
      {
        devs.length > 0 && (
          <BarreFiltres vue="devs" nom="studios" total={devs.length} />
        )
      }
      {
        devs.length === 0 && (
          <p class="bloc bloc--c bloc-blanc s-liste__vide">
            Les studios de cette édition seront bientôt annoncés, revenez un peu
            plus tard !
          </p>
        )
      }

      <ul class="grille">
        {
          devs.map((dev, i) => {
            const image = imageStudio(dev);
            const plateau = dev.jeux.some(estJeuDePlateau);
            const video = dev.jeux.some(estJeuVideo);
            return (
              <li
                data-plateau={plateau ? "1" : undefined}
                data-video={video ? "1" : undefined}
              >
                <a
                  class:list={["bloc", COUPES[i % 4], "tuile"]}
                  href={`/festival/devs/${devSlug(dev)}`}
                >
                  <span class="tuile__vign">
                    {image ? (
                      <Image
                        class="tuile__img"
                        src={image}
                        alt={`Logo du studio ${dev.nom_studio}`}
                        width={420}
                        fit="inside"
                        loading="lazy"
                        decoding="async"
                        inferSize
                      />
                    ) : (
                      <svg
                        class="tuile__de"
                        viewBox="0 0 4230 4458"
                        aria-hidden="true"
                        focusable="false"
                      >
                        <use href="#psuf-champsu" />
                      </svg>
                    )}
                  </span>
                  <span class="tuile__corps">
                    <span class="tuile__nom">{dev.nom_studio}</span>
                    {dev.jeux.length > 0 && (
                      <span class="tuile__meta">
                        {dev.jeux.map((jeu) => jeu.nom_jeu).join(" · ")}
                      </span>
                    )}
                    <span class="tuile__types">
                      {plateau && (
                        <span class="type type--plateau">
                          <svg
                            class="type__pico"
                            viewBox="0 0 200 195"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <use href="#psuf-doodle-meeple" />
                          </svg>
                          Plateau
                        </span>
                      )}
                      {video && (
                        <span class="type type--video">
                          <svg
                            class="type__pico"
                            viewBox="0 0 200 172"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <use href="#psuf-doodle-manette" />
                          </svg>
                          Vidéo
                        </span>
                      )}
                    </span>
                  </span>
                  <span class="tuile__plus">
                    Voir le studio <i aria-hidden="true">→</i>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Coquille>
