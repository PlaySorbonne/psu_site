---
/*
 * Play Sorbonne Festival 2026 : la page du festival.
 *
 * Charte : les affiches 2026 de Lou Cardon. Aplats francs, blocs
 * polygonaux, dé isométrique, grain, aucun néon. La page se lit d'une
 * traite : huit bandes dont les dégradés se raccordent bord à bord, donc
 * aucune ligne de séparation nulle part (voir la chaîne --de/--vers dans
 * src/styles/psuf2026.css).
 *
 * Les faits sont dans src/data/psuf2026.ts, relevés sur les documents
 * officiels de l'édition. Les jeux et les studios viennent de l'API
 * gamedevs, au moment du build.
 */
import HeaderL from "@/layouts/partials/HeaderL.astro";
import "@/styles/psuf2026.css";

import Sprite from "@/components/festival/psuf2026/Sprite.astro";
import Entete from "@/components/festival/psuf2026/Entete.astro";
import Rail from "@/components/festival/psuf2026/Rail.astro";
import Hero from "@/components/festival/psuf2026/Hero.astro";
import Programme from "@/components/festival/psuf2026/Programme.astro";
import Plan from "@/components/festival/psuf2026/Plan.astro";
import Programmation from "@/components/festival/psuf2026/Programmation.astro";
import Tournois from "@/components/festival/psuf2026/Tournois.astro";
import Jeux from "@/components/festival/psuf2026/Jeux.astro";
import Associations from "@/components/festival/psuf2026/Associations.astro";
import RendezVous from "@/components/festival/psuf2026/RendezVous.astro";
import Pied from "@/components/festival/psuf2026/Pied.astro";

import {
  getDevs,
  estJeuDePlateau,
  estJeuVideo,
  devSlug,
  imagesJeu,
  imageStudio,
} from "@/helpers/gamedevs";
import { festival } from "@/data/psuf2026";

const devs = await getDevs();

/*
 * Les compteurs, calculés comme sur les deux pages dédiées pour que les
 * chiffres du site concordent. Un jeu de code « 3 » relève des deux
 * familles : plateau + vidéo dépasse donc le total des jeux, et la
 * section le dit au lieu de le cacher.
 */
const tousLesJeux = devs.flatMap((dev) => dev.jeux);
const nbJeux = tousLesJeux.length;
const nbStudios = devs.length;
const nbPlateau = tousLesJeux.filter(estJeuDePlateau).length;
const nbVideo = tousLesJeux.filter(estJeuVideo).length;

/*
 * L'aperçu défilant : on ne garde que les jeux qui ont un visuel, et on
 * alterne plateau / vidéo pour que les deux familles se voient d'un coup
 * d'œil. Trente-deux tuiles, seize par bande, chacune cliquable vers la
 * fiche du jeu sur la page de son studio.
 */
const TUILES_PAR_BANDE = 16;

type Tuile = {
  jeu: string;
  studio: string;
  plateau: boolean;
  image: string;
  lien: string;
};

const candidats = devs.flatMap((dev) =>
  dev.jeux.map((jeu) => ({
    jeu: jeu.nom_jeu,
    studio: dev.nom_studio,
    plateau: estJeuDePlateau(jeu),
    image: imagesJeu(jeu)[0] ?? imageStudio(dev),
    lien: `/festival/devs/${devSlug(dev)}#jeu-${jeu.id}`,
  })),
);

const avecVisuel = candidats.filter((t): t is Tuile => !!t.image);
const filePlateau = avecVisuel.filter((t) => t.plateau);
const fileVideo = avecVisuel.filter((t) => !t.plateau);

const alterne: Tuile[] = [];
for (let i = 0; alterne.length < TUILES_PAR_BANDE * 2; i++) {
  const p = filePlateau[i];
  const v = fileVideo[i];
  if (!p && !v) break;
  if (p) alterne.push(p);
  if (v && alterne.length < TUILES_PAR_BANDE * 2) alterne.push(v);
}

const bandes: [Tuile[], Tuile[]] = [
  alterne.slice(0, TUILES_PAR_BANDE),
  alterne.slice(TUILES_PAR_BANDE),
];

const releve = new Date().toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<HeaderL
  title="Festival Play Sorbonne 2026"
  description={`${festival.dateTexte}, ${festival.horaires}, ${festival.adresse}. ${nbStudios} studios indépendants, ${nbJeux} jeux jouables, sept conférences, des tournois et un jeu de rôle sur scène. Entrée libre sur inscription.`}
  metaImg="/assets/festival/psuf2026/og.jpg"
  prefetchs={["/festival/devs", "/festival/jeux"]}
>
  <div class="psuf">
    <Sprite />
    <span class="grain" aria-hidden="true"></span>

    <Entete />
    <Rail />

    <main>
      <Hero jeux={nbJeux} studios={nbStudios} />
      <Programme />
      <Plan />
      <Programmation />
      <Tournois />
      <Jeux
        jeux={nbJeux}
        studios={nbStudios}
        plateau={nbPlateau}
        video={nbVideo}
        bandes={bandes}
        releve={releve}
      />
      <Associations />
      <RendezVous />
    </main>

    <Pied />
  </div>
</HeaderL>
